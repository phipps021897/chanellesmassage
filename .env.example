# Copy this file to .env for local development:
#   cp .env.example .env
#
# Both values come from your Supabase project: Project Settings > API.
# The anon key is designed to be public (Supabase's Row Level Security
# policies, defined in supabase/schema.sql, are what actually protect data)
# so it's safe to also set these as repo *variables* (not secrets) in
# GitHub Actions so the production build can use them.

PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
