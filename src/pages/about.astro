---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceholderPhoto from '../components/PlaceholderPhoto.astro';
import { business } from '../data/site';
import { withBase } from '../lib/url';
---

<BaseLayout
  title="About"
  description={`Meet the therapist behind ${business.name} in Weymouth, Dorset.`}
>
  <section class="mx-auto grid max-w-6xl items-center gap-12 px-6 py-16 md:grid-cols-2">
    <PlaceholderPhoto label="Photo of Chanelle" />
    <div>
      <h1 class="font-display text-4xl font-semibold text-brand-forest">About {business.shortName}</h1>
      <!-- TODO: replace with Chanelle's real bio — qualifications, years of experience,
           what drew her to massage therapy, and what clients can expect from a session. -->
      <p class="mt-6 text-brand-ink/80">
        Chanelle is a qualified sports massage therapist based in Weymouth, dedicated to helping
        clients recover, move better and feel their best. Every treatment starts with a
        conversation about what your body needs that day, whether that's recovery from training,
        easing a problem area, or general maintenance.
      </p>
      <!-- TODO: add qualifications / certifications, e.g. ITEC / VTCT Level 3 Diploma in
           Sports Massage, insurance body membership, years practising, specialisms. -->
      <p class="mt-4 text-brand-ink/80">
        Fully qualified and insured, specialising in sports massage for everyone from weekend
        athletes to busy professionals carrying everyday tension.
      </p>
      <a
        href={withBase('/booking/')}
        class="mt-8 inline-block rounded-full bg-brand-forest px-7 py-3 text-sm font-semibold tracking-wide text-brand-cream uppercase hover:bg-brand-forest-dark"
      >
        Book an appointment
      </a>
    </div>
  </section>

  <section class="bg-brand-sage-light/40 py-16">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h2 class="font-display text-3xl font-semibold text-brand-forest">My approach</h2>
      <!-- TODO: replace with Chanelle's real philosophy / values statement. -->
      <p class="mx-auto mt-4 max-w-2xl text-brand-ink/70">
        Every client is different, so every session starts with a conversation about your goals —
        whether that's recovering from training, managing a recurring niggle, or simply keeping
        on top of day-to-day tension.
      </p>
    </div>
  </section>
</BaseLayout>
