---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceholderPhoto from '../components/PlaceholderPhoto.astro';
import { business } from '../data/site';
import { withBase } from '../lib/url';

type GalleryItem =
  | { photo: string; alt: string; placeholder?: never }
  | { placeholder: string; photo?: never; alt?: never };

const items: GalleryItem[] = [
  { photo: 'treatment-room.jpg', alt: "Treatment room at Chanelle's Massage" },
  { placeholder: 'Reception / waiting area' },
  { photo: 'massage-back-window.jpg', alt: 'Sports massage treatment in progress' },
  { placeholder: 'Product / oils detail shot' },
  { placeholder: 'Exterior / signage' },
  { photo: 'massage-leg.jpg', alt: 'Chanelle performing a sports massage treatment' },
];
---

<BaseLayout
  title="Gallery"
  description="A look inside Chanelle's Massage studio in Weymouth."
>
  <section class="mx-auto max-w-6xl px-6 py-16">
    <h1 class="font-display text-4xl font-semibold text-brand-forest">Gallery</h1>
    <p class="mt-4 max-w-2xl text-brand-ink/70">
      A few glimpses of the studio and treatments on offer. Follow along on{' '}
      <a href={business.social.instagram} class="font-semibold underline underline-offset-4">
        Instagram
      </a>,{' '}
      <a href={business.social.facebook} class="font-semibold underline underline-offset-4">
        Facebook
      </a>{' '}
      or{' '}
      <a href={business.social.tiktok} class="font-semibold underline underline-offset-4">
        TikTok
      </a>{' '}
      for the latest.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) =>
          item.photo ? (
            <img
              src={withBase(`images/gallery/${item.photo}`)}
              alt={item.alt}
              loading="lazy"
              class="aspect-4/3 w-full rounded-2xl border border-brand-sage/30 object-cover"
            />
          ) : (
            <PlaceholderPhoto label={item.placeholder as string} />
          )
        )
      }
    </div>
  </section>
</BaseLayout>
