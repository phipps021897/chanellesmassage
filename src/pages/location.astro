---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/site';

// Generic Weymouth town-centre map. TODO: once the real studio address is
// confirmed, replace this with a Google Maps embed for that exact address
// (Google Maps > Share > Embed a map) or update the OSM bbox/marker below.
const osmEmbedSrc =
  'https://www.openstreetmap.org/export/embed.html?bbox=-2.4800%2C50.6050%2C-2.4200%2C50.6350&layer=mapnik&marker=50.6150%2C-2.4500';
---

<BaseLayout
  title="Location"
  description={`Find Chanelle's Massage in ${business.town}. Parking and directions.`}
>
  <section class="mx-auto max-w-6xl px-6 py-16">
    <h1 class="font-display text-4xl font-semibold text-brand-forest">Location</h1>

    <div class="mt-10 grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-semibold text-brand-forest">Address</h2>
        <!-- TODO: replace with the real studio address -->
        <address class="mt-3 text-brand-ink/80 not-italic">
          {business.address.line1}<br />
          {business.address.line2}<br />
          {business.address.region}<br />
          {business.address.postcode}
        </address>

        <h2 class="mt-8 font-display text-2xl font-semibold text-brand-forest">Getting here</h2>
        <!-- TODO: add real parking / bus / train directions -->
        <ul class="mt-3 list-disc space-y-2 pl-5 text-brand-ink/80">
          <li>Add parking details (e.g. on-site parking, nearby car parks)</li>
          <li>Add public transport directions (nearest bus stop / Weymouth station)</li>
          <li>Add accessibility notes if relevant (step-free access, etc.)</li>
        </ul>

        <h2 class="mt-8 font-display text-2xl font-semibold text-brand-forest">Opening hours</h2>
        <table class="mt-3 w-full max-w-sm text-sm text-brand-ink/80">
          <tbody>
            {
              business.hours.map((h) => (
                <tr class="border-b border-brand-sage/20">
                  <td class="py-2 font-medium">{h.day}</td>
                  <td class="py-2 text-right">
                    {h.open && h.close ? `${h.open} – ${h.close}` : 'Closed'}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="overflow-hidden rounded-2xl border border-brand-sage/30">
        <iframe
          src={osmEmbedSrc}
          class="h-full min-h-[400px] w-full"
          loading="lazy"
          title="Map showing the approximate area of Chanelle's Massage in Weymouth"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
