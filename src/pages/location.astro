---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/site';

const fullAddress = `${business.address.line1}, ${business.address.line2}, ${business.address.locality}, ${business.address.postcode}`;
const mapEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}&output=embed`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(fullAddress)}`;

const anchorDisplay = new Date('2026-10-12T00:00:00').toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title="Location"
  description={`Find Chanelle's Massage in ${business.town}. Parking and directions.`}
>
  <section class="mx-auto max-w-6xl px-6 py-16">
    <h1 class="font-display text-4xl font-semibold text-brand-forest">Location</h1>

    <div class="mt-10 grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-semibold text-brand-forest">Address</h2>
        <address class="mt-3 text-brand-ink/80 not-italic">
          {business.address.line1}<br />
          {business.address.line2}<br />
          {business.address.locality}, {business.address.region}<br />
          {business.address.postcode}
        </address>

        <h2 class="mt-8 font-display text-2xl font-semibold text-brand-forest">Opening hours</h2>

        <div data-legacy-block class="mt-3">
          <p class="text-sm font-semibold text-brand-gold uppercase">
            Current hours (new schedule begins {anchorDisplay})
          </p>
          <table class="mt-1 w-full max-w-sm text-sm text-brand-ink/80">
            <tbody>
              {
                business.legacyHours.map((h) => (
                  <tr class="border-b border-brand-sage/20">
                    <td class="py-1.5 pr-2 font-medium">{h.day}</td>
                    <td class="py-1.5 text-right whitespace-nowrap">
                      {h.open && h.close ? `${h.open}–${h.close}` : 'Closed'}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="mt-6 text-xs text-brand-ink/50">
          From {anchorDisplay}, hours alternate fortnightly between two schedules:
        </p>

        <div class="mt-3 grid gap-4 sm:grid-cols-2">
          <div data-week-block="1">
            <p class="text-sm font-semibold text-brand-gold uppercase" data-week-label="1">Week 1</p>
            <table class="mt-1 w-full text-sm text-brand-ink/80">
              <tbody>
                {
                  business.week1Hours.map((h) => (
                    <tr class="border-b border-brand-sage/20">
                      <td class="py-1.5 pr-2 font-medium">{h.day}</td>
                      <td class="py-1.5 text-right whitespace-nowrap">
                        {h.open && h.close ? `${h.open}–${h.close}` : 'Closed'}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <div data-week-block="2">
            <p class="text-sm font-semibold text-brand-gold uppercase" data-week-label="2">Week 2</p>
            <table class="mt-1 w-full text-sm text-brand-ink/80">
              <tbody>
                {
                  business.week2Hours.map((h) => (
                    <tr class="border-b border-brand-sage/20">
                      <td class="py-1.5 pr-2 font-medium">{h.day}</td>
                      <td class="py-1.5 text-right whitespace-nowrap">
                        {h.open && h.close ? `${h.open}–${h.close}` : 'Closed'}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div>
        <div class="overflow-hidden rounded-2xl border border-brand-sage/30">
          <iframe
            src={mapEmbedSrc}
            class="h-full min-h-[400px] w-full"
            loading="lazy"
            title={`Map showing ${business.name} at ${fullAddress}`}
          ></iframe>
        </div>
        <a
          href={directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-block rounded-full bg-brand-forest px-6 py-2.5 text-sm font-semibold tracking-wide text-brand-cream uppercase hover:bg-brand-forest-dark"
        >
          Get directions
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { getWeekNumberForDate, isOnOrAfterAnchor } from '../lib/biweekly';

  // Computed client-side (not at build time) so it's always correct for
  // whoever is viewing the page today, regardless of when the site was last
  // deployed.
  const now = new Date();
  if (isOnOrAfterAnchor(now)) {
    document.querySelectorAll('[data-legacy-block]').forEach((el) => {
      (el as HTMLElement).style.display = 'none';
    });

    const current = getWeekNumberForDate(now);
    document.querySelectorAll('[data-week-label]').forEach((el) => {
      if (el.getAttribute('data-week-label') === String(current)) {
        el.textContent += ' (this week)';
      }
    });
  }
</script>
