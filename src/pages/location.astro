---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/site';
import { getCoordinatesForAddress } from '../lib/geocode.server';

const fullAddress = `${business.address.line1}, ${business.address.line2}, ${business.address.locality}, ${business.address.postcode}`;

// Geocoded by postcode — the street/estate name alone doesn't resolve via
// Nominatim, but the postcode does and is precise enough for a small UK
// postcode. See src/lib/geocode.server.ts for the fallback if this fails.
const { lat, lon } = await getCoordinatesForAddress(business.address.postcode);
const delta = { lat: 0.003, lon: 0.004 };
const mapEmbedSrc =
  `https://www.openstreetmap.org/export/embed.html` +
  `?bbox=${lon - delta.lon}%2C${lat - delta.lat}%2C${lon + delta.lon}%2C${lat + delta.lat}` +
  `&layer=mapnik&marker=${lat}%2C${lon}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(fullAddress)}`;
---

<BaseLayout
  title="Location"
  description={`Find Chanelle's Massage in ${business.town}. Parking and directions.`}
>
  <section class="mx-auto max-w-6xl px-6 py-16">
    <h1 class="font-display text-4xl font-semibold text-brand-forest">Location</h1>

    <div class="mt-10 grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-semibold text-brand-forest">Address</h2>
        <address class="mt-3 text-brand-ink/80 not-italic">
          {business.address.line1}<br />
          {business.address.line2}<br />
          {business.address.locality}, {business.address.region}<br />
          {business.address.postcode}
        </address>

        <h2 class="mt-8 font-display text-2xl font-semibold text-brand-forest">Opening hours</h2>
        <table class="mt-3 w-full max-w-sm text-sm text-brand-ink/80">
          <tbody>
            {
              business.hours.map((h) => (
                <tr class="border-b border-brand-sage/20">
                  <td class="py-2 font-medium">{h.day}</td>
                  <td class="py-2 text-right">
                    {h.open && h.close ? `${h.open} – ${h.close}` : 'Closed'}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div>
        <div class="overflow-hidden rounded-2xl border border-brand-sage/30">
          <iframe
            src={mapEmbedSrc}
            class="h-full min-h-[400px] w-full"
            loading="lazy"
            title={`Map showing ${business.name} at ${fullAddress}`}
          ></iframe>
        </div>
        <a
          href={directionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-block rounded-full bg-brand-forest px-6 py-2.5 text-sm font-semibold tracking-wide text-brand-cream uppercase hover:bg-brand-forest-dark"
        >
          Get directions
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
