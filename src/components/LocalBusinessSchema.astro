---
import { business } from '../data/site';

// Hours alternate fortnightly (see src/lib/biweekly.ts), which schema.org's
// OpeningHoursSpecification has no clean way to express as a repeating
// pattern — encoding just one week would tell search engines the wrong
// hours half the time, so it's omitted rather than published incorrectly.
// The Location page shows both weeks to actual visitors instead.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  name: business.name,
  description: business.metaDescription,
  url: Astro.site?.toString(),
  image: new URL(`${import.meta.env.BASE_URL}images/logo.jpg`, Astro.site).toString(),
  telephone: business.phoneDisplay,
  email: business.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${business.address.line1}, ${business.address.line2}`,
    addressLocality: business.address.locality,
    addressRegion: business.address.region,
    postalCode: business.address.postcode,
    addressCountry: 'GB',
  },
  sameAs: [business.social.instagram, business.social.facebook, business.social.tiktok],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
