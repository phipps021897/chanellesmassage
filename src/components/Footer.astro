---
import { business, nav } from '../data/site';
import { withBase } from '../lib/url';

const year = new Date(Date.now()).getFullYear();
---

<footer class="mt-24 border-t border-brand-sage/30 bg-brand-forest text-brand-cream">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-12 md:grid-cols-3">
    <div>
      <p class="font-script text-3xl">{business.name}</p>
      <p class="mt-2 text-sm text-brand-sage-light">{business.tagline}</p>
      <a
        href={business.social.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-block text-sm font-medium text-brand-blush hover:text-brand-cream"
      >
        @chanellesmassage on Instagram
      </a>
    </div>

    <div>
      <p class="text-sm font-semibold tracking-wide uppercase text-brand-blush">Explore</p>
      <ul class="mt-3 space-y-2">
        {
          nav.map((item) => (
            <li>
              <a href={withBase(item.href)} class="text-sm text-brand-sage-light hover:text-brand-cream">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold tracking-wide uppercase text-brand-blush">Contact</p>
      <ul class="mt-3 space-y-2 text-sm text-brand-sage-light">
        <li><a href={business.phoneHref} class="hover:text-brand-cream">{business.phoneDisplay}</a></li>
        <li><a href={`mailto:${business.email}`} class="hover:text-brand-cream">{business.email}</a></li>
        <li>{business.address.line2}, {business.address.region}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-brand-cream/10 px-6 py-4 text-center text-xs text-brand-sage-light">
    &copy; {year} {business.name}. All rights reserved.
  </div>
</footer>
